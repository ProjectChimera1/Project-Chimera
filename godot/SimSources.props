<Project>

  <!-- ============================================================================================
       SINGLE SOURCE OF TRUTH for the Godot-free deterministic sim source set. (Story 1.10b, Task 1.)

       Imported by BOTH:
         - godot/ProjectChimera.Sim.Tests   (the Tier-1 golden-checksum harness), and
         - godot/ProjectChimera.Sim.Analysis (the banned-API + AOT analyzer gate, Story 1.10b)
       so the analyzer's coverage can NEVER silently drift from the tested source set: a sim folder
       added here is picked up by the tests AND the analyzers in the same edit.

       Paths are anchored to $(MSBuildThisFileDirectory) (= godot/) — NOT '..\' — so the set resolves
       to the identical absolute files regardless of which sibling project (one level below godot/)
       imports it. The content below was extracted behavior-neutrally from ProjectChimera.Sim.Tests.csproj.

       This is the pure-sim source compiled DIRECTLY (not a <ProjectReference> to godot.csproj, which would
       drag GodotSharp in and break the Godot-free guarantee). FixedPoint.cs's #if GODOT bridge methods
       compile out because neither importer defines the GODOT symbol.
       ============================================================================================ -->

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)src\Core\**\*.cs"       LinkBase="Sim\Core" />
    <Compile Include="$(MSBuildThisFileDirectory)src\Combat\**\*.cs"     LinkBase="Sim\Combat" />
    <Compile Include="$(MSBuildThisFileDirectory)src\Economy\**\*.cs"    LinkBase="Sim\Economy" />
    <Compile Include="$(MSBuildThisFileDirectory)src\Navigation\**\*.cs" LinkBase="Sim\Navigation" />
    <!-- AI: the live 10-system tick loop includes AiOpponentSystem (src/AI/, namespace
         ProjectChimera.AI). src/AI/ is verified Godot-free (AiOpponentSystem.cs + LLMService.cs,
         which uses System.Net.Http, not Godot). Required so the golden harness can build the full loop,
         and so the analyzer quantifies the known AI float→Fixed debt (advisory). -->
    <Compile Include="$(MSBuildThisFileDirectory)src\AI\**\*.cs"         LinkBase="Sim\AI" />
    <!-- Story 2.1 (AR-8): the net-new Effect-Graph surface (src/Effects/, namespace ProjectChimera.Effects).
         Pure C# / Fixed-only / Godot-free. Globbed HERE so it is covered automatically by BOTH the Tier-1
         golden harness (ProjectChimera.Sim.Tests) AND the determinism analyzer gate (ProjectChimera.Sim.Analysis)
         — without this line the new code would compile into neither, a silent coverage hole. Dsl/ (Epic 7) is
         still net-new; add its include HERE when the folder exists. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\Effects\**\*.cs"    LinkBase="Sim\Effects" />
    <!-- Story 7.2 (Epic 7): the graph-canonical trigger DSL IR (src\Dsl\, namespace ProjectChimera.Dsl). Pure C# /
         Fixed-only / Godot-free. Globbed HERE so it is covered by BOTH the Tier-1 golden harness
         (ProjectChimera.Sim.Tests) AND the determinism analyzer gate (ProjectChimera.Sim.Analysis) — the seam the
         "Dsl/ … add its include HERE when the folder exists" note above reserved. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\Dsl\**\*.cs"        LinkBase="Sim\Dsl" />

    <!-- Story 1.5: explicit single-file includes so the .chmr record→replay round-trip (with the v2 seed
         header) is Tier-1 testable. These three Multiplayer files are verified Godot-free (System.* + Core
         only); the rest of src/Multiplayer (LockstepManager, ENet transports) is Godot/ENet-coupled, so the
         folder is deliberately NOT globbed. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\ReplayRecorder.cs" LinkBase="Sim\Multiplayer" />
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\ReplayPlayer.cs"   LinkBase="Sim\Multiplayer" />
    <!-- Story 9.11: the lightweight header/metadata reader for the replay browser — Godot-free (System.* + Core),
         Tier-1 testable (HeaderRead_ReturnsMetadata) beside the recorder/player round-trip. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\ReplayHeader.cs"   LinkBase="Sim\Multiplayer" />
    <!-- Story 9.11: Godot-free replay formatting/policy helpers (duration/result/speed-clamp) — Tier-1 testable
         and the single reference to the authoritative sim tick rate. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\ReplayFormat.cs"   LinkBase="Sim\Multiplayer" />
    <!-- DW-431: the replay playback view-perspective state machine extracted from MainScene so the session
         transitions (begin/cycle/end-of-session reveal-all reset) are Tier-1 testable. Single-file include —
         the ReplayFormat precedent; the rest of src/Multiplayer stays Godot/ENet-coupled and un-globbed. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\ReplayPerspectiveState.cs" LinkBase="Sim\Multiplayer" />
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\NetworkCommand.cs" LinkBase="Sim\Multiplayer" />
    <!-- Story 1.11 (AC2a): the Godot-free adaptive-input-delay math (RTT→delay clamp + commutative agreement)
         extracted from LockstepManager so it is Tier-1 unit-testable (DelayMathTests). Single-file include —
         the rest of src/Multiplayer (LockstepManager, ENet transports) is Godot/ENet-coupled. Its float RTT math
         trips the 1.10b advisory CHM0001, which is expected/correct (the delay value is never folded into the hash). -->
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\DelayMath.cs"       LinkBase="Sim\Multiplayer" />
    <!-- DW-390: the Godot-free merged-arrival ring/gate/seed decision extracted from LockstepManager (the
         DelayMath precedent) so the Story-9.3 client gate — keying, the stall/apply predicate, bootstrap/delay-gap
         seeding — is Tier-1 unit-testable (MergedArrivalRingTests). Pure integer/byte state, no float. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\MergedArrivalRing.cs" LinkBase="Sim\Multiplayer" />
    <!-- DW-912: the Godot-free ONLINE fixed-timestep pacer (the MergedArrivalRing precedent) — the frame→tick
         budget + the "a stall banks nothing" rule that keeps the client's command-packet rate a property of the
         30 Hz tick rate rather than of the frame rate. The frame-paced online loop it replaces sent ~252
         packets/sec on a 252 FPS machine, tripped the server's 60/sec anti-spam throttle, and deadlocked the
         match at tick 64 with no recovery path. Tier-1 tested (LockstepPacerTests) so the send-rate bound is a
         pinned property, not a comment. Wall-clock pacing — never folded into SimChecksum. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\LockstepPacer.cs" LinkBase="Sim\Multiplayer" />
    <!-- DW-447: the Godot-free independent per-peer sim (own SimulationHost + deterministic scripted orders +
         real per-tick SimChecksum) shared by the in-Godot LoopbackDesyncSelfTest AND the Tier-1
         IndependentPeerSimQuorumTests — so "N independent sims compute + compare their own checksums" is
         exercised headlessly, not just by the manual LAN runbook. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\LoopbackPeerSim.cs" LinkBase="Sim\Multiplayer" />
    <!-- Story 7.7: the pure lobby start-handshake decision (hash-0 blocks / mismatch blocks / equal-nonzero
         allows) extracted from LobbyUi so it is Tier-1 unit-testable (HandshakeGateTests). Single-file include —
         the DelayMath precedent; the rest of src/Multiplayer stays Godot/ENet-coupled and un-globbed. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\HandshakeGate.cs"   LinkBase="Sim\Multiplayer" />
    <!-- DW-360: the Godot-free Ready-packet ROUTING around HandshakeGate (parse → protocol-version gate →
         parsed-flag + local/peer hash-argument marshalling into CheckStart → peer-slot resolution) extracted from
         LobbyUi's Ready handler so the wiring — not just the pure CheckStart decision — is Tier-1 unit-testable
         (ReadyPacketRoutingTests). Single-file include; LobbyUi stays Godot-coupled and un-globbed. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\ReadyPacketRouting.cs" LinkBase="Sim\Multiplayer" />
    <!-- DW-402/DW-403: the client-side PROTOCOL_VERSION gate + mismatch-recovery latch (inbound-Hello block,
         peer-Ready version block, valid-Hello recovery) extracted from LobbyUi so both client version clauses are
         Tier-1 unit-testable (LobbyVersionGateTests) — before this, deleting either clause reopened the D3.8 gap
         with a green suite. Single-file include — the HandshakeGate precedent. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\LobbyVersionGate.cs" LinkBase="Sim\Multiplayer" />
    <!-- DW-417 note: the branch's parallel MergedStreamGate extraction was superseded at merge time by DW-390's
         MergedArrivalRing above (the SAME ring, extracted first on master and already the production gate
         LockstepManager delegates to). DW-417's drop-unstall regression test (ClientDropFlushGateTests) drives
         MergedArrivalRing directly, so the "tests the PRODUCTION gate" intent is preserved without a duplicate ring. -->
    <!-- DW-419/DW-420: the pure client-side Hello-role interpretation (assigned-player / P2P-host-confirm /
         dedicated-spectator) + the lobby-chat local-echo decision, extracted from LobbyUi so the dedicated-vs-P2P
         discriminator is Tier-1 unit-testable (LobbyHelloPolicyTests). Single-file include — the HandshakeGate
         precedent; the rest of src/Multiplayer stays Godot/ENet-coupled and un-globbed. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\LobbyHelloPolicy.cs" LinkBase="Sim\Multiplayer" />
    <!-- DW-464: the Godot-free guaranteed-delivery Concede buffer (sticky queue + last-slot reservation + per-send
         claim) extracted from LockstepManager's enqueue/send path so the never-drop-a-concede policy is Tier-1
         unit-testable (ConcedeBufferTests). Single-file include — the DelayMath/HandshakeGate precedent. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\ConcedeBuffer.cs"   LinkBase="Sim\Multiplayer" />
    <!-- Story 9.7: new Godot-free decision cores — the N-player matchmaker parameterization, the N-slot lobby
         readiness model, the pure party model, and the Godot-free faction/team palette table. Single-file/folder
         includes (the DelayMath/HandshakeGate precedent) so each is Tier-1 unit-testable while the rest of
         src/Multiplayer + src/UI stays Godot-coupled and un-globbed. (SlotAllocation/AssignedRoster live under
         src/Multiplayer/Server/** and are already folder-globbed below.) -->
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\Matchmaking\MatchmakerConfig.cs" LinkBase="Sim\Multiplayer\Matchmaking" />
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\PlayerCountPolicy.cs"            LinkBase="Sim\Multiplayer" />
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\LobbyReadyModel.cs"              LinkBase="Sim\Multiplayer" />
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\Party\PartyState.cs"             LinkBase="Sim\Multiplayer\Party" />
    <Compile Include="$(MSBuildThisFileDirectory)src\UI\FactionPalette.cs"                        LinkBase="Sim\UI" />
    <!-- DW-385: the Godot-free chat line formatter (speaker name/color from FactionPalette + BBCode sanitization)
         behind MatchChatOverlay. Single-file include (the FactionPalette precedent) so the 8-player speaker
         mapping is Tier-1 asserted while the overlay itself stays Godot-coupled and un-globbed. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\UI\MatchChatFormat.cs"                       LinkBase="Sim\UI" />
    <!-- DW-374: the Godot-free chat dash-command→bounded-code parser behind MatchChatOverlay's player_chat raise
         (the MatchChatFormat precedent). Single-file include so the authorable "-N" → SendPlayerChat mapping is
         Tier-1 asserted while the overlay itself stays Godot-coupled and un-globbed. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\UI\MatchChatCommands.cs"                     LinkBase="Sim\UI" />
    <!-- Asset-texture pipeline: the Godot-free team-tint decision + blend math behind TeamTintMaterial
         (the FactionPalette precedent). Single-file include so the load-bearing safety rule — art with no
         albedo texture renders EXACTLY as it did under the old flat material_override — is Tier-1 asserted
         rather than only observable in-engine, while the material construction stays Godot-coupled. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\UI\TeamTintPolicy.cs"                        LinkBase="Sim\UI" />

    <!-- Story 6.2: the linear editor undo/redo stack (src/CreationSuite/EditorHistory.cs) is pure C# (Action
         delegate pairs over two Stacks, no Godot types) — included as a single file so its shared-LIFO contract,
         now shared by entity placement AND terrain strokes, is Tier-1 unit-testable (EditorHistoryTests). The rest
         of src/CreationSuite is Godot-coupled, so the folder is deliberately NOT globbed. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\CreationSuite\EditorHistory.cs" LinkBase="Sim\CreationSuite" />

    <!-- Story 1.9a: the Godot-free server-authority core (ServerHost + ServerChecksumCollector) lives under
         src/Multiplayer/Server/ — a guaranteed-Godot-free subfolder. Folder-globbed (not single files) so the
         Epic-9 additions (ProtocolVersion / DelayController) are picked up without touching this file. -->
    <Compile Include="$(MSBuildThisFileDirectory)src\Multiplayer\Server\**\*.cs" LinkBase="Sim\Multiplayer\Server" />

    <!-- The only Godot-coupled file remaining in the sim folders is MainScene (the god object, strangled in
         1.8a/c). StressTest was relocated to godot/tools/ in Story 1.8a, so it is no longer under the
         src\Core\** glob and needs no <Compile Remove>. FixedPoint.cs STAYS IN (Godot bridge is #if GODOT). -->
    <Compile Remove="$(MSBuildThisFileDirectory)src\Core\MainScene.cs" />
    <!-- DW-882: MainSceneDebugSeam.cs is a PARTIAL of that same Godot-coupled god object (Node3D, OS.IsDebugBuild,
         Godot.Collections.Dictionary), so it follows MainScene.cs out of the Godot-free assembly. It holds no sim
         logic to Tier-1 test — it only reads/forwards to code that is already covered. -->
    <Compile Remove="$(MSBuildThisFileDirectory)src\Core\MainSceneDebugSeam.cs" />
    <!-- Story 1.8c: the Godot-TOUCHING concrete setup phases + SceneContext live under Bootstrap/Phases/ and
         must NOT enter this Godot-free assembly (they hold CanvasLayer/Node handles). The Godot-FREE phase
         kernel (ISetupPhase / DelegateSetupPhase / ScenePhaseOrder / ScenePhaseRunner) stays directly under
         Bootstrap/ and remains globbed-in + Tier-1-testable (PhaseOrderTest reads it). GodotFreeBoundaryTest
         is the backstop if anything Godot-touching ever lands outside Phases/. -->
    <Compile Remove="$(MSBuildThisFileDirectory)src\Core\Bootstrap\Phases\**\*.cs" />
  </ItemGroup>

</Project>
