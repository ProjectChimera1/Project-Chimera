<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Godot-free: intentionally NOT Godot.NET.Sdk and the GODOT symbol is NOT defined here,
         so FixedPoint.cs's #if GODOT bridge methods compile out. -->
    <!-- Story 1.10a (AR-2/AR-35 reproducibility): commit a packages.lock.json pinning the full transitive
         package graph. The CI determinism gate restores in locked mode so the dependency surface cannot
         drift silently. Regenerate intentionally with `dotnet restore` after an approved dependency change. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- SHARED SOURCE: the pure-sim source set now lives in godot/SimSources.props (Story 1.10b, Task 1) — a
       single source of truth imported by BOTH this test project and ProjectChimera.Sim.Analysis so the
       analyzer gate's coverage can never drift from the tested set. Behavior-neutral extraction: this project
       compiles the identical file set it did before (the props anchors to $(MSBuildThisFileDirectory)=godot/).
       Compiled DIRECTLY, not via a <ProjectReference> to godot.csproj (that would drag GodotSharp in and break
       the Godot-free guarantee). -->
  <Import Project="..\SimSources.props" />

  <ItemGroup>
    <!-- Golden baseline: embedded so it's read via manifest stream (portable across Windows/Linux — no
         file-path or line-ending fragility, required for the 1.10c cross-platform gate). The <None Remove>
         pre-empts an NETSDK1022 duplicate-item error with the SDK's default None glob. -->
    <None Remove="Golden\golden-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\golden-scenario.golden.txt" />
    <!-- Story 1.3a multi-faction (4 active factions) golden — same embedded/manifest transport. -->
    <None Remove="Golden\golden-multifaction.golden.txt" />
    <EmbeddedResource Include="Golden\golden-multifaction.golden.txt" />
    <!-- Story 1.8b applier-driven golden — the alpha_map_01 mirror applied through the Godot-free ScenarioApplier
         (Validated<ScenarioData> -> Apply). A NEW file; the two goldens above are never re-recorded. -->
    <None Remove="Golden\golden-applier-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\golden-applier-scenario.golden.txt" />
    <!-- Story 1.9a AR-40 fork #1 — cross-faction same-tick tie-break golden. NEW file; the three goldens
         above are never re-recorded here. -->
    <None Remove="Golden\same-tick-tie-break.golden.txt" />
    <EmbeddedResource Include="Golden\same-tick-tie-break.golden.txt" />
    <!-- Story 1.11 (AC1) — AI-ACTIVE golden (Player2 AiOpponentSystem active). SAME-MACHINE ONLY: it encodes
         the AI's float scoring (D2), so AiActiveGoldenTests gates the golden-match on Windows and it is
         deliberately EXCLUDED from the 1.10c Win↔Linux cross-platform gate. NEW file; goldens above untouched. -->
    <None Remove="Golden\ai-active-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\ai-active-scenario.golden.txt" />
    <!-- Story 1.12 (AC6d) — command-vocabulary golden (one Player1 unit per order; Player2 empty so the AI
         no-ops). Integer/Fixed-only → CROSS-PLATFORM SAFE: compared by the normal Tier-1 run on both CI legs
         (Windows + Linux/WSL), NOT Windows-gated like the AI-active golden. NEW file; goldens above untouched. -->
    <None Remove="Golden\command-vocabulary-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\command-vocabulary-scenario.golden.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only. Pin the exact versions `dotnet restore` resolves so CI (Story 1.10a) is reproducible.
         Known-good baseline; bump to current stable if newer. xUnit 2.x is the conservative choice. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
