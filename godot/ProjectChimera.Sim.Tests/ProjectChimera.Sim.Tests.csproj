<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Godot-free: intentionally NOT Godot.NET.Sdk and the GODOT symbol is NOT defined here,
         so FixedPoint.cs's #if GODOT bridge methods compile out. -->
    <!-- Story 1.10a (AR-2/AR-35 reproducibility): commit a packages.lock.json pinning the full transitive
         package graph. The CI determinism gate restores in locked mode so the dependency surface cannot
         drift silently. Regenerate intentionally with `dotnet restore` after an approved dependency change. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- SHARED SOURCE: the pure-sim source set now lives in godot/SimSources.props (Story 1.10b, Task 1) — a
       single source of truth imported by BOTH this test project and ProjectChimera.Sim.Analysis so the
       analyzer gate's coverage can never drift from the tested set. Behavior-neutral extraction: this project
       compiles the identical file set it did before (the props anchors to $(MSBuildThisFileDirectory)=godot/).
       Compiled DIRECTLY, not via a <ProjectReference> to godot.csproj (that would drag GodotSharp in and break
       the Godot-free guarantee). -->
  <Import Project="..\SimSources.props" />

  <!-- Story 9.8: the Godot-free proof-of-play/publish cores live in src/UGC (beside ModIoService), which is
       deliberately OUTSIDE SimSources.props (and thus outside the banned-API analyzer's globbed set — they use
       System.Security.Cryptography / off-tick, presentation-side wall-clock). Included here as single files so they
       are Tier-1 unit-testable WITHOUT being swept into the determinism analyzer gate. ProofOfPlayToken.cs lives in
       src/Core/Definitions and is already globbed by SimSources.props. -->
  <ItemGroup>
    <Compile Include="..\src\UGC\ProofOfPlaySigner.cs" LinkBase="Sim\UGC" />
    <Compile Include="..\src\UGC\ProofOfPlayStore.cs"  LinkBase="Sim\UGC" />
    <Compile Include="..\src\UGC\PublishGate.cs"       LinkBase="Sim\UGC" />
    <Compile Include="..\src\UGC\ProofOfPlayMint.cs"   LinkBase="Sim\UGC" />
    <!-- Story 9.10: include ModIoService as a single file so its pure BuildModsUrl seam is Tier-1 testable
         (mirrors the UGC includes above; deliberately OUTSIDE SimSources.props / the determinism analyzer set —
         it is off-tick, Godot-free, presentation-adjacent HTTP glue). -->
    <Compile Include="..\src\UGC\ModIoService.cs"      LinkBase="Sim\UGC" />
    <!-- Story 11.4 (FR-74): the Godot-free presentation policy cores — the under-attack region/time throttle and the
         total denial-reason→text map — included as single files so the throttle policy + reason-map totality are
         Tier-1 testable (they live under src/UI, which SimSources.props does NOT glob; deliberately OUTSIDE the
         determinism analyzer set — they are presentation-side). -->
    <Compile Include="..\src\UI\UnderAttackThrottle.cs" LinkBase="Sim\UI" />
    <Compile Include="..\src\UI\DenialReasonText.cs"    LinkBase="Sim\UI" />
    <!-- Story 11.5 (FR-74): the Godot-free presentation cores — the WC3 subgroup grouping policy + the buff/debuff
         polarity classifier — included as single files so their policy is Tier-1 testable (they live under src/UI,
         which SimSources.props does NOT glob; deliberately OUTSIDE the determinism analyzer set — presentation-side). -->
    <Compile Include="..\src\UI\SelectionSubgroups.cs" LinkBase="Sim\UI" />
    <Compile Include="..\src\UI\ModifierPolarity.cs"   LinkBase="Sim\UI" />
    <!-- DW-163: the Godot-free start-slot arithmetic (declared-set / lowest-undeclared / max-declared) extracted from
         EntityPlacer.RefreshSubRow so the non-contiguous slot logic is Tier-1 testable without Godot. Lives under
         src/UI (NOT globbed by SimSources.props), included as a single file like the presentation cores above. -->
    <Compile Include="..\src\UI\StartSlotMath.cs" LinkBase="Sim\UI" />
    <!-- DW-159: the Godot-free map-bounds predicate extracted from EntityPlacer.WithinMapBounds, included as a single
         file (src/UI is not globbed by SimSources.props) so the off-map paste/move guard is Tier-1 testable. -->
    <Compile Include="..\src\UI\MapBoundsMath.cs" LinkBase="Sim\UI" />
    <!-- DW-169: the Godot-free building nav-footprint resolution policy (authored nav_footprint > built-in table >
         mesh AABB > guarded default) extracted from NavObstacleManager, included as a single file (src/UI is not
         globbed by SimSources.props) so the resolution order is Tier-1 testable. -->
    <Compile Include="..\src\UI\BuildingNavFootprint.cs" LinkBase="Sim\UI" />
    <!-- DW-345: the Godot-free variable-picker eligibility policy extracted from TriggerEditorPanel.RefreshVarPickers
         (src/CreationSuite is not globbed by SimSources.props — the EditorHistory single-file precedent) so the
         legacy-path PerPlayer exclusion is Tier-1 testable. -->
    <Compile Include="..\src\CreationSuite\TriggerVarPickerPolicy.cs" LinkBase="Sim\CreationSuite" />
    <!-- DW-406/DW-408: the Godot-free minimap fog policy core — the RevealAll-honoring fog-texture alpha map and the
         fog-visibility dot gate — included as a single file (src/UI is not globbed by SimSources.props) so both
         minimap fog decisions are Tier-1 testable against a real FogOfWarSystem. Presentation-side, never hashed. -->
    <Compile Include="..\src\UI\MinimapFogPolicy.cs" LinkBase="Sim\UI" />
  </ItemGroup>

  <!-- Story 9.12: the SHARED C#<->TS hero-profile validation oracle. Embedded (read via manifest stream, like the
       goldens) so HeroProfileValidatorTests drives HeroProfileValidator off the SAME cases the TS vitest suite runs —
       the two validators cannot silently drift. The single source of truth lives under the nakama-module tree. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\server-deploy\nakama-modules\test\fixtures\validation-cases.json">
      <LogicalName>validation-cases.json</LogicalName>
    </EmbeddedResource>
    <!-- DW-438: the SHARED wire fixture — the EXACT JsonSerializer.Serialize(PlayerProfile) bytes the client RPC
         sends. PlayerProfileWireParityTests pins the fixture byte-for-byte against the live serializer; the TS
         csharp-roundtrip.test.ts feeds the same bytes to the validator + handlers. One source of truth, so a
         wire-format drift cannot ship with the rule-parity suites green. -->
    <EmbeddedResource Include="..\..\docs\server-deploy\nakama-modules\test\fixtures\csharp-serialized-profile.json">
      <LogicalName>csharp-serialized-profile.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

