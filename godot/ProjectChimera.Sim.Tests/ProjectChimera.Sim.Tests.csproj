<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Godot-free: intentionally NOT Godot.NET.Sdk and the GODOT symbol is NOT defined here,
         so FixedPoint.cs's #if GODOT bridge methods compile out. -->
    <!-- Story 1.10a (AR-2/AR-35 reproducibility): commit a packages.lock.json pinning the full transitive
         package graph. The CI determinism gate restores in locked mode so the dependency surface cannot
         drift silently. Regenerate intentionally with `dotnet restore` after an approved dependency change. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- SHARED SOURCE: the pure-sim source set now lives in godot/SimSources.props (Story 1.10b, Task 1) — a
       single source of truth imported by BOTH this test project and ProjectChimera.Sim.Analysis so the
       analyzer gate's coverage can never drift from the tested set. Behavior-neutral extraction: this project
       compiles the identical file set it did before (the props anchors to $(MSBuildThisFileDirectory)=godot/).
       Compiled DIRECTLY, not via a <ProjectReference> to godot.csproj (that would drag GodotSharp in and break
       the Godot-free guarantee). -->
  <Import Project="..\SimSources.props" />

  <ItemGroup>
    <!-- Golden baseline: embedded so it's read via manifest stream (portable across Windows/Linux — no
         file-path or line-ending fragility, required for the 1.10c cross-platform gate). The <None Remove>
         pre-empts an NETSDK1022 duplicate-item error with the SDK's default None glob. -->
    <None Remove="Golden\golden-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\golden-scenario.golden.txt" />
    <!-- Story 1.3a multi-faction (4 active factions) golden — same embedded/manifest transport. -->
    <None Remove="Golden\golden-multifaction.golden.txt" />
    <EmbeddedResource Include="Golden\golden-multifaction.golden.txt" />
    <!-- Story 1.8b applier-driven golden — the alpha_map_01 mirror applied through the Godot-free ScenarioApplier
         (Validated<ScenarioData> -> Apply). A NEW file; the two goldens above are never re-recorded. -->
    <None Remove="Golden\golden-applier-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\golden-applier-scenario.golden.txt" />
    <!-- Story 1.9a AR-40 fork #1 — cross-faction same-tick tie-break golden. NEW file; the three goldens
         above are never re-recorded here. -->
    <None Remove="Golden\same-tick-tie-break.golden.txt" />
    <EmbeddedResource Include="Golden\same-tick-tie-break.golden.txt" />
    <!-- Story 1.11 (AC1) — AI-ACTIVE golden (Player2 AiOpponentSystem active). SAME-MACHINE ONLY: it encodes
         the AI's float scoring (D2), so AiActiveGoldenTests gates the golden-match on Windows and it is
         deliberately EXCLUDED from the 1.10c Win↔Linux cross-platform gate. NEW file; goldens above untouched. -->
    <None Remove="Golden\ai-active-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\ai-active-scenario.golden.txt" />
    <!-- Story 1.12 (AC6d) — command-vocabulary golden (one Player1 unit per order; Player2 empty so the AI
         no-ops). Integer/Fixed-only → CROSS-PLATFORM SAFE: compared by the normal Tier-1 run on both CI legs
         (Windows + Linux/WSL), NOT Windows-gated like the AI-active golden. NEW file; goldens above untouched. -->
    <None Remove="Golden\command-vocabulary-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\command-vocabulary-scenario.golden.txt" />
    <!-- Story 1.13 (AC6d) — formation-separation golden (a moving unit pushing through idle units, units of
         different CollisionRadius, a Push-vs-Yield pair; Player2 empty so the AI no-ops). Integer/Fixed-only →
         CROSS-PLATFORM SAFE: compared on both CI legs, NOT Windows-gated. NEW file; goldens above untouched. -->
    <None Remove="Golden\formation-separation-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\formation-separation-scenario.golden.txt" />
    <!-- Story 2.2b (AC2/AC3) — modifier-active golden (four stationary P1 units through a fixed
         apply/refresh/stack/ignore/DoT/HoT/Energy schedule; Player2 empty so the AI no-ops). The first golden with
         ACTIVE ModifierStore state. Integer/Fixed-only → CROSS-PLATFORM SAFE, compared on both CI legs. NEW file. -->
    <None Remove="Golden\modifier-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\modifier-scenario.golden.txt" />
    <!-- Story 2.4a (AC3) — ability-cast golden (one P1 caster casts a Self battle_fury via a CastAbility UnitOrder;
         Player2 empty so the AI no-ops). First golden with a LIVE ability cast; exercises the v7 cooldown fold.
         Integer/Fixed-only → CROSS-PLATFORM SAFE, compared on both CI legs. NEW file; goldens above untouched. -->
    <None Remove="Golden\ability-cast-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\ability-cast-scenario.golden.txt" />
    <!-- Story 2.6 (AC4) — passive-active golden (an aura owner buffing an armored ally, a Neutral on-hit attacker,
         and a self-regen unit; Player2 empty so the AI no-ops). First golden exercising all three passive drivers
         AND the v8 EffectiveArmor fold with a non-zero armor value. Integer/Fixed-only → CROSS-PLATFORM SAFE,
         compared on both CI legs. NEW file; goldens above are re-baselined once for the v8 fold. -->
    <None Remove="Golden\passive-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\passive-scenario.golden.txt" />
    <!-- Story 2.9a (AC3.4) — THREE new goldens (goldens above are NOT re-recorded; AlgoVersion stays 8, no fold):
         combat-air-ground (an AttackDomain=Air unit ignoring a nearer ground enemy), anti-building (melee+ranged
         Siege razing a Neutral building, incl. a real projectile), and ability-domain-filter (a SearchArea(Air) cast
         sparing a co-located ground unit). All integer/Fixed, Neutral targets, Player2 empty → CROSS-PLATFORM SAFE,
         compared on both CI legs. -->
    <None Remove="Golden\combat-air-ground-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\combat-air-ground-scenario.golden.txt" />
    <None Remove="Golden\anti-building-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\anti-building-scenario.golden.txt" />
    <None Remove="Golden\ability-domain-filter-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\ability-domain-filter-scenario.golden.txt" />
    <!-- Story 2.9b (AC4.2) — worker-cast + crystal-cost golden (a gathering P1 worker casts a crystal-costed Self
         ability at tick 1; Player2 empty so the AI no-ops). First golden with a WORKER cast AND a crystal debit.
         Integer/Fixed-only → CROSS-PLATFORM SAFE, compared on both CI legs. NEW file; the 13 goldens above are NOT
         re-recorded (AlgoVersion stays 8, no fold). -->
    <None Remove="Golden\worker-cast-crystal-cost-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\worker-cast-crystal-cost-scenario.golden.txt" />
    <!-- Story 2.10 (AC4 / D-5) — equal-exchange golden (one stationary P1 caster casts a Self
         Sequence[apply_modifier, direct_hp_delta] Equal Exchange ability at tick 1; Player2 empty so the AI no-ops).
         First golden pinning a Sequence with a FLAT armor-independent HP self-cost. Integer/Fixed-only →
         CROSS-PLATFORM SAFE, compared on both CI legs. NEW file; the 14 goldens above are NOT re-recorded
         (AlgoVersion stays 8, no fold). -->
    <None Remove="Golden\equal-exchange-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\equal-exchange-scenario.golden.txt" />
    <!-- Story 2.11 (AC6.2) — tag-filter golden (a stationary P1 caster casts a Self ability exercising a
         require_tag:Mechanical SearchArea + a require_tag:Organic heal SearchArea + a single-target require_tag:Mechanical
         DAMAGE leaf gate, over a mixed-tag Neutral set; Player2 empty so the AI no-ops). First golden exercising the
         Story-2.11 tag axis. Integer/Fixed-only → CROSS-PLATFORM SAFE, compared on both CI legs. NEW file; the 15 goldens
         above are NOT re-recorded (AlgoVersion stays 8, no fold). -->
    <None Remove="Golden\tag-filter-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\tag-filter-scenario.golden.txt" />
    <!-- Story 2.12 (AC2.4 / AC3.5) — shift-queue golden (a Shift-queued 3-waypoint Move chain drained by
         OrderQueueSystem + a P1 Barracks issued SetRally + Train so a grunt walks to rally; Player2 empty so the AI
         no-ops). First golden exercising the v9 per-entity order-queue fold + the per-building rally fold (D-1).
         Integer/Fixed-only → CROSS-PLATFORM SAFE, compared on both CI legs. NEW file; the 16 goldens above ARE
         re-recorded once for the v9 fold (algo_version 8→9, every hash moves, sample count unchanged). -->
    <None Remove="Golden\shift-queue-scenario.golden.txt" />
    <EmbeddedResource Include="Golden\shift-queue-scenario.golden.txt" />
    <!-- Story 3.2 (AC3 / Task 5) — hero start-state golden. NOT a per-tick SimChecksum sequence: it pins the single
         64-bit FNV-64 StartStateHash over the HeroStartStateScenario fixture (2-slot model + 2 minted heroes) — the
         recorded model-layout pin (AC3's 2nd pin). Integer/Fixed.Raw only → CROSS-PLATFORM SAFE, compared on both CI
         legs. NEW file; the 17 per-tick goldens above are NOT re-recorded (SimChecksum AlgoVersion stays 9, no fold). -->
    <None Remove="Golden\hero-start-state.golden.txt" />
    <EmbeddedResource Include="Golden\hero-start-state.golden.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only. Pin the exact versions `dotnet restore` resolves so CI (Story 1.10a) is reproducible.
         Known-good baseline; bump to current stable if newer. xUnit 2.x is the conservative choice. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
