--- /dev/null
+++ b/godot/src/Multiplayer/OnlineProfileSource.cs
@@ -0,0 +1,53 @@
+#nullable enable
+using System;
+using System.Collections.Generic;
+using ProjectChimera.Core.Definitions; // IProfileSource, PlayerProfile
+
+namespace ProjectChimera.Multiplayer
+{
+    /// <summary>
+    /// Story 9.12 (FR-7c / AR-12) — the ONLINE hero-profile rail: an <see cref="IProfileSource"/> over
+    /// <see cref="NakamaService"/> whose only write path is the validating server RPC. It reads the single server-owned
+    /// storage object (owner-read) and writes ONLY through <see cref="NakamaService.WriteHeroProfileViaRpcAsync"/> — it
+    /// NEVER calls <c>WriteStorageObjects</c>, so a tampered client can never inject a raw profile object (Nakama's
+    /// no-client-write permission is the server-side backstop; this class is the client-side contract).
+    ///
+    /// <para>SDK-coupled and thin (like <see cref="NakamaService"/>/<c>PartyService</c>): untested per repo convention —
+    /// the validity rules it depends on are Tier-1 tested in <c>HeroProfileValidator</c> and the TS mirror. The
+    /// <see cref="IProfileSource"/> surface is synchronous, so the async Nakama calls are bridged with a blocking wait;
+    /// callers on latency-sensitive threads should prefer the async <see cref="NakamaService"/> methods directly.</para>
+    /// </summary>
+    public sealed class OnlineProfileSource : IProfileSource
+    {
+        private readonly NakamaService _nakama;
+
+        public OnlineProfileSource(NakamaService nakama)
+            => _nakama = nakama ?? throw new ArgumentNullException(nameof(nakama));
+
+        /// <summary>Read the single server-owned profile object (0 or 1). Fail-soft — no object / not connected ⇒ empty.</summary>
+        public IReadOnlyList<PlayerProfile> LoadAll()
+        {
+            PlayerProfile? p = _nakama.ReadHeroProfileAsync().GetAwaiter().GetResult();
+            return p == null ? Array.Empty<PlayerProfile>() : new List<PlayerProfile> { p };
+        }
+
+        /// <summary>Persist ONLY through the validating server RPC. Throws when the server rejects the payload (the
+        /// object is never written client-side, so a rejection must not be swallowed as a silent success).</summary>
+        public void Save(PlayerProfile profile)
+        {
+            if (profile == null) return;
+            StorageWriteResult result = _nakama.WriteHeroProfileViaRpcAsync(profile).GetAwaiter().GetResult();
+            if (!result.Ok)
+                throw new InvalidOperationException(
+                    $"Server rejected hero profile '{profile.ProfileId}': {result.Reason ?? "unknown"}.");
+        }
+
+        /// <summary>No client-side delete path exists for the server-owned object (there is no delete RPC in this slice);
+        /// a no-op keeps the picker's delete affordance harmless online.</summary>
+        public void Delete(string profileId) { /* server-owned object; no client delete RPC in this slice */ }
+
+        /// <summary>There is exactly one server profile object per user (key <c>profile</c>), so the id is deterministic
+        /// from the hero-def id — no per-slot counter. Matches the offline id shape so <c>MintId</c> stays stable.</summary>
+        public string NextProfileId(string heroDefId) => (heroDefId ?? "") + "#online";
+    }
+}
