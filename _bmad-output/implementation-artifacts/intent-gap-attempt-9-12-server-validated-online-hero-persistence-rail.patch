+// Story 9.12 — Project Chimera Nakama server runtime module (TypeScript).
+//
+// Registers the two server RPCs that make the online hero profile server-authoritative (FR-7c / AR-12):
+//   • rpc_write_hero_profile  — parse → validate → write the profile as an Owner-Read / No-Client-Write storage object.
+//   • rpc_attest_hero_profile — read the stored object → re-validate → return { attested, reason }.
+//
+// The validity rules live in ./validation.ts, which MIRRORS godot/src/Core/Definitions/HeroProfileValidator.cs. The
+// storage object is written with permissionRead=1 (owner-read) and permissionWrite=0 (NO client write), so a client can
+// read its own profile but can NEVER inject or edit it via a raw WriteStorageObjects — the only write path is this
+// validating RPC. Collection/key + rpc ids MUST match the C# NakamaService constants.
+
+import type * as nkruntime from 'nkruntime';
+import { validateHeroProfile, type HeroProfile } from './validation.ts';
+
+const HERO_COLLECTION = 'heroes';
+const HERO_KEY = 'profile';
+const RPC_WRITE = 'rpc_write_hero_profile';
+const RPC_ATTEST = 'rpc_attest_hero_profile';
+
+/**
+ * rpc_write_hero_profile — validate the client payload and, ONLY if valid, write the owner-read/no-client-write storage
+ * object. An invalid payload writes nothing and returns { ok:false, reason }.
+ */
+function rpcWriteHeroProfile(
+  ctx: nkruntime.Context,
+  logger: nkruntime.Logger,
+  nk: nkruntime.Nakama,
+  payload: string,
+): string {
+  let profile: HeroProfile;
+  try {
+    profile = JSON.parse(payload || '{}');
+  } catch (e) {
+    return JSON.stringify({ ok: false, reason: 'bad_json' });
+  }
+
+  const result = validateHeroProfile(profile);
+  if (!result.valid) {
+    logger.warn('rpc_write_hero_profile rejected profile for user %s: %s', ctx.userId, result.reason);
+    return JSON.stringify({ ok: false, reason: result.reason });
+  }
+
+  // Server-owned write: read=1 (owner-read), write=0 (no client write). userId = the authenticated caller.
+  const acks = nk.storageWrite([
+    {
+      collection: HERO_COLLECTION,
+      key: HERO_KEY,
+      userId: ctx.userId,
+      value: profile as unknown as { [key: string]: any },
+      permissionRead: 1,
+      permissionWrite: 0,
+    },
+  ]);
+
+  const version = acks && acks.length > 0 ? acks[0].version : undefined;
+  return JSON.stringify({ ok: true, version: version });
+}
+
+/**
+ * rpc_attest_hero_profile — read the caller's stored profile object, re-validate it, and attest. Returns
+ * { attested:false, reason:'not_found' } when no object exists; { attested:false, reason } when it fails validation
+ * (or its id disagrees with the requested profileId); { attested:true } only for a present, valid, matching profile.
+ */
+function rpcAttestHeroProfile(
+  ctx: nkruntime.Context,
+  logger: nkruntime.Logger,
+  nk: nkruntime.Nakama,
+  payload: string,
+): string {
+  let requestedId = '';
+  try {
+    const req = JSON.parse(payload || '{}');
+    if (req && typeof req.profileId === 'string') requestedId = req.profileId;
+  } catch (e) {
+    // A malformed request payload is non-fatal — attest whatever is stored.
+  }
+
+  const objects = nk.storageRead([{ collection: HERO_COLLECTION, key: HERO_KEY, userId: ctx.userId }]);
+  if (!objects || objects.length === 0) {
+    return JSON.stringify({ attested: false, reason: 'not_found' });
+  }
+
+  const stored = objects[0].value as HeroProfile;
+  const result = validateHeroProfile(stored);
+  if (!result.valid) {
+    return JSON.stringify({ attested: false, reason: result.reason });
+  }
+
+  // Defensive: the requested id (if any) must match the stored object's id.
+  if (requestedId.length > 0 && stored.profile_id !== requestedId) {
+    return JSON.stringify({ attested: false, reason: 'identity' });
+  }
+
+  return JSON.stringify({ attested: true });
+}
+
+// Nakama entry point — registered functions are loaded from the bundled build/index.js mounted into /nakama/data/modules.
+function InitModule(
+  ctx: nkruntime.Context,
+  logger: nkruntime.Logger,
+  nk: nkruntime.Nakama,
+  initializer: nkruntime.Initializer,
+): void {
+  initializer.registerRpc(RPC_WRITE, rpcWriteHeroProfile);
+  initializer.registerRpc(RPC_ATTEST, rpcAttestHeroProfile);
+  logger.info('Project Chimera hero-profile module loaded (rpc: %s, %s).', RPC_WRITE, RPC_ATTEST);
+}
+
+// Reference InitModule so the bundler does not tree-shake it away (it is invoked by the Nakama runtime, not by us).
+!InitModule && InitModule.bind(null);

diff --git a/docs/server-deploy/nakama-modules/src/validation.ts b/docs/server-deploy/nakama-modules/src/validation.ts
new file mode 100644
index 0000000..a5d5304
--- /dev/null
+++ b/docs/server-deploy/nakama-modules/src/validation.ts
@@ -0,0 +1,86 @@
+// Story 9.12 — the canonical hero-profile validity rules, server-side (TypeScript).
+//
+// This is the server-side MIRROR of godot/src/Core/Definitions/HeroProfileValidator.cs. The two implementations MUST
+// stay in sync rule-for-rule — if you change one, change the other and both test suites. There is no live-Nakama test
+// in CI, so the C# xUnit suite and this file's node test are the only proof the rules match.
+//
+// The profile JSON shape is exactly what C# System.Text.Json emits for PlayerProfile (snake_case property names):
+//   { profile_id, hero_def_id, faction_id, display_name, signature_ability,
+//     values:    [ { key, raw } ],           // hero.level as its int, hero.xp as its Fixed 16.16 raw
+//     inventory: [ { item_id, charges, slot } ] }
+
+/** Fixed(30000) in 16.16 raw = 30000 * 65536. MUST equal HeroXpSystem.XpCeiling.Raw on the C# side. */
+export const XP_CEILING_RAW = 30000 * 65536; // 1_966_080_000
+
+export type ProfileInvalidReason = 'none' | 'identity' | 'range' | 'inventory' | 'attributes';
+
+export interface ProfileAttributeValue { key: string; raw: number; }
+export interface ProfileInventoryItem { item_id: string; charges: number; slot: number; }
+export interface HeroProfile {
+  profile_id?: string;
+  hero_def_id?: string;
+  values?: ProfileAttributeValue[];
+  inventory?: ProfileInventoryItem[];
+}
+
+export interface ProfileValidation { valid: boolean; reason: ProfileInvalidReason; }
+
+function isBlank(s: unknown): boolean {
+  return typeof s !== 'string' || s.trim().length === 0;
+}
+
+/** Linear lookup of a persisted raw by key (mirrors PlayerProfile.RawOf); 0 when absent. */
+function rawOf(values: ProfileAttributeValue[], key: string): number {
+  for (let i = 0; i < values.length; i++) {
+    if (values[i] && values[i].key === key) return values[i].raw | 0;
+  }
+  return 0;
+}
+
+/** The DW-12 level/xp range rule — mirrors HeroProfileValidator.IsLevelXpInRange EXACTLY. */
+export function isLevelXpInRange(level: number, xpRaw: number): boolean {
+  return level >= 0 && xpRaw >= 0 && xpRaw <= XP_CEILING_RAW;
+}
+
+/**
+ * Validate a hero profile against the canonical rule set, in the SAME order as the C# validator so the returned reason
+ * matches: identity -> range -> attributes -> inventory. Never a silent clamp — reject fail-closed.
+ */
+export function validateHeroProfile(profile: HeroProfile | null | undefined): ProfileValidation {
+  if (!profile || typeof profile !== 'object') return { valid: false, reason: 'identity' };
+
+  // 1) Identity.
+  if (isBlank(profile.profile_id) || isBlank(profile.hero_def_id)) {
+    return { valid: false, reason: 'identity' };
+  }
+
+  const values: ProfileAttributeValue[] = Array.isArray(profile.values) ? profile.values : [];
+  const inventory: ProfileInventoryItem[] = Array.isArray(profile.inventory) ? profile.inventory : [];
+
+  // 2) Range (level / xp).
+  const level = rawOf(values, 'hero.level');
+  const xpRaw = rawOf(values, 'hero.xp');
+  if (!isLevelXpInRange(level, xpRaw)) {
+    return { valid: false, reason: 'range' };
+  }
+
+  // 3) Attributes — every raw >= 0, no duplicate keys.
+  for (let i = 0; i < values.length; i++) {
+    if (!values[i] || (values[i].raw | 0) < 0) return { valid: false, reason: 'attributes' };
+    for (let j = i + 1; j < values.length; j++) {
+      if (values[j] && values[j].key === values[i].key) return { valid: false, reason: 'attributes' };
+    }
+  }
+
+  // 4) Inventory — every charge >= 0, no duplicate non-negative slot (a legacy slot of -1 is the "first free" sentinel).
+  for (let i = 0; i < inventory.length; i++) {
+    if (!inventory[i] || (inventory[i].charges | 0) < 0) return { valid: false, reason: 'inventory' };
+    const slot = inventory[i].slot | 0;
+    if (slot < 0) continue;
+    for (let j = i + 1; j < inventory.length; j++) {
+      if (inventory[j] && (inventory[j].slot | 0) === slot) return { valid: false, reason: 'inventory' };
+    }
+  }
+
+  return { valid: true, reason: 'none' };
+}

diff --git a/docs/server-deploy/nakama-modules/test/validation.test.ts b/docs/server-deploy/nakama-modules/test/validation.test.ts
new file mode 100644
index 0000000..0f9aa9c
--- /dev/null
+++ b/docs/server-deploy/nakama-modules/test/validation.test.ts
@@ -0,0 +1,106 @@
+// Story 9.12 — node test for the server-side validateHeroProfile mirror. Covers every row of the spec I/O matrix, the
+// same rows the C# HeroProfileValidatorTests cover, so the two implementations are proven in sync without a live Nakama.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  validateHeroProfile,
+  isLevelXpInRange,
+  XP_CEILING_RAW,
+  type HeroProfile,
+} from '../src/validation.ts';
+
+function profile(over: Partial<HeroProfile> = {}): HeroProfile {
+  return {
+    profile_id: 'grommash#1',
+    hero_def_id: 'grommash',
+    values: [
+      { key: 'hero.level', raw: 3 },
+      { key: 'hero.xp', raw: 786432 },
+    ],
+    inventory: [],
+    ...over,
+  };
+}
+
+// ── Valid ──
+test('valid well-formed profile', () => {
+  assert.deepEqual(validateHeroProfile(profile()), { valid: true, reason: 'none' });
+});
+
+test('xp exactly at ceiling is valid (inclusive)', () => {
+  const p = profile({ values: [{ key: 'hero.level', raw: 1 }, { key: 'hero.xp', raw: XP_CEILING_RAW }] });
+  assert.equal(validateHeroProfile(p).valid, true);
+});
+
+test('legacy slotless inventory (multiple -1) is valid', () => {
+  const p = profile({ inventory: [{ item_id: 'ring', charges: 0, slot: -1 }, { item_id: 'potion', charges: 2, slot: -1 }] });
+  assert.equal(validateHeroProfile(p).valid, true);
+});
+
+// ── Range ──
+test('negative level -> range', () => {
+  assert.equal(validateHeroProfile(profile({ values: [{ key: 'hero.level', raw: -1 }] })).reason, 'range');
+});
+
+test('negative xp -> range', () => {
+  const p = profile({ values: [{ key: 'hero.level', raw: 1 }, { key: 'hero.xp', raw: -1 }] });
+  assert.equal(validateHeroProfile(p).reason, 'range');
+});
+
+test('xp above ceiling -> range', () => {
+  const p = profile({ values: [{ key: 'hero.level', raw: 1 }, { key: 'hero.xp', raw: XP_CEILING_RAW + 1 }] });
+  assert.equal(validateHeroProfile(p).reason, 'range');
+});
+
+// ── Identity ──
+test('blank profile_id -> identity', () => {
+  assert.equal(validateHeroProfile(profile({ profile_id: '   ' })).reason, 'identity');
+});
+
+test('blank hero_def_id -> identity', () => {
+  assert.equal(validateHeroProfile(profile({ hero_def_id: '' })).reason, 'identity');
+});
+
+test('null profile -> identity', () => {
+  assert.equal(validateHeroProfile(null).reason, 'identity');
+});
+
+// ── Inventory ──
+test('negative charges -> inventory', () => {
+  const p = profile({ inventory: [{ item_id: 'ring', charges: -1, slot: 0 }] });
+  assert.equal(validateHeroProfile(p).reason, 'inventory');
+});
+
+test('duplicate slot -> inventory', () => {
+  const p = profile({ inventory: [{ item_id: 'ring', charges: 0, slot: 2 }, { item_id: 'potion', charges: 0, slot: 2 }] });
+  assert.equal(validateHeroProfile(p).reason, 'inventory');
+});
+
+// ── Attributes ──
+test('negative attribute raw -> attributes', () => {
+  const p = profile({ values: [{ key: 'hero.level', raw: 1 }, { key: 'hero.strength', raw: -5 }] });
+  assert.equal(validateHeroProfile(p).reason, 'attributes');
+});
+
+test('duplicate attribute key -> attributes', () => {
+  const p = profile({ values: [{ key: 'hero.level', raw: 1 }, { key: 'hero.level', raw: 2 }] });
+  assert.equal(validateHeroProfile(p).reason, 'attributes');
+});
+
+// ── Range is checked before attributes ──
+test('negative level reports range, not attributes', () => {
+  assert.equal(validateHeroProfile(profile({ values: [{ key: 'hero.level', raw: -3 }] })).reason, 'range');
+});
+
+// ── The range predicate matches the former inline gate ──
+test('isLevelXpInRange matches the C# predicate', () => {
+  assert.equal(isLevelXpInRange(0, 0), true);
+  assert.equal(isLevelXpInRange(3, XP_CEILING_RAW), true);
+  assert.equal(isLevelXpInRange(-1, 0), false);
+  assert.equal(isLevelXpInRange(1, -1), false);
+  assert.equal(isLevelXpInRange(1, XP_CEILING_RAW + 1), false);
+});
+
+test('XP_CEILING_RAW equals Fixed(30000) in 16.16', () => {
+  assert.equal(XP_CEILING_RAW, 1966080000);
+});

