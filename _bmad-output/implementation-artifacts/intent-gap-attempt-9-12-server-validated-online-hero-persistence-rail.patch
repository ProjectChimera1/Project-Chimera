@@ -0,0 +1,34 @@
+#nullable enable
+namespace ProjectChimera.Core.Definitions
+{
+    /// <summary>
+    /// Story 9.12 — the result of a server hero-profile attestation (from <c>rpc_attest_hero_profile</c>). Godot-free /
+    /// SDK-free so both the Godot-coupled <c>NakamaService</c> (which produces it from the RPC reply) and the pure
+    /// <see cref="OnlineHeroLaunchGate"/> (which consumes it) can name it. <see cref="Attested"/> = the server found the
+    /// stored profile object; <see cref="Valid"/> = it passed the server-side validator; <see cref="Reason"/> carries a
+    /// surfaceable reason string when it did not (e.g. <c>"not_found"</c>, <c>"range"</c>).
+    /// </summary>
+    public readonly record struct AttestationOutcome(bool Attested, bool Valid, string? Reason)
+    {
+        /// <summary>A clean pass — the server attested a valid stored profile.</summary>
+        public static readonly AttestationOutcome Ok = new(true, true, null);
+
+        /// <summary>No stored object / attestation not obtained (e.g. offline, RPC error) — never enter a match.</summary>
+        public static AttestationOutcome NotAttested(string? reason = "unattested") => new(false, false, reason);
+
+        /// <summary>The server returned the object but it failed validation — never enter a match.</summary>
+        public static AttestationOutcome Rejected(string? reason) => new(true, false, reason);
+    }
+
+    /// <summary>
+    /// Story 9.12 (FR-7c / AR-12) — the pure launch predicate the online hero picker gates on at StartGame. Mirrors the
+    /// <c>ServerLobbyPolicy</c> idiom: a Godot-free static decision, Tier-1 unit-testable, so the "an unattested or
+    /// invalid profile can never enter online play" invariant is verified without a live Nakama. A profile may enter a
+    /// match ONLY when the server both attested it (the object exists, server-owned) AND it is valid.
+    /// </summary>
+    public static class OnlineHeroLaunchGate
+    {
+        /// <summary>True iff <paramref name="outcome"/> is both attested AND valid — the single online-launch gate.</summary>
+        public static bool CanEnterMatch(AttestationOutcome outcome) => outcome.Attested && outcome.Valid;
+    }
+}

