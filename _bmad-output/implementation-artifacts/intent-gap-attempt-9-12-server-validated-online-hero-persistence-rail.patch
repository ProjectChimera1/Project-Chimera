@@ -0,0 +1,57 @@
+// Minimal ambient declaration of the Nakama runtime type surface used by this module (Story 9.12). The full official
+// types ship with Nakama; this local shim declares only what src/main.ts references, so `tsc --noEmit` typechecks
+// without a network dependency. These types are `import type`-only and are erased by the bundler at build time.
+
+declare module 'nkruntime' {
+  export interface Context {
+    userId: string;
+  }
+
+  export interface Logger {
+    info(format: string, ...args: any[]): void;
+    warn(format: string, ...args: any[]): void;
+    error(format: string, ...args: any[]): void;
+  }
+
+  export interface StorageWriteRequest {
+    collection: string;
+    key: string;
+    userId?: string;
+    value: { [key: string]: any };
+    version?: string;
+    permissionRead?: number;
+    permissionWrite?: number;
+  }
+
+  export interface StorageWriteAck {
+    collection: string;
+    key: string;
+    userId: string;
+    version: string;
+  }
+
+  export interface StorageReadRequest {
+    collection: string;
+    key: string;
+    userId?: string;
+  }
+
+  export interface StorageObject {
+    collection: string;
+    key: string;
+    userId: string;
+    version: string;
+    value: { [key: string]: any };
+  }
+
+  export interface Nakama {
+    storageWrite(writes: StorageWriteRequest[]): StorageWriteAck[];
+    storageRead(reads: StorageReadRequest[]): StorageObject[];
+  }
+
+  export type RpcFunction = (ctx: Context, logger: Logger, nk: Nakama, payload: string) => string;
+
+  export interface Initializer {
+    registerRpc(id: string, func: RpcFunction): void;
+  }
+}

diff --git a/godot/ProjectChimera.Sim.Tests/Definitions/HeroProfileValidatorTests.cs b/godot/ProjectChimera.Sim.Tests/Definitions/HeroProfileValidatorTests.cs
new file mode 100644
index 0000000..fa6aef5
--- /dev/null
+++ b/godot/ProjectChimera.Sim.Tests/Definitions/HeroProfileValidatorTests.cs
@@ -0,0 +1,177 @@
+#nullable enable
+using System.Collections.Generic;
+using ProjectChimera.Core;               // Fixed
+using ProjectChimera.Core.Definitions;   // PlayerProfile, HeroProfileValidator, ProfileInvalidReason
+using ProjectChimera.Combat;             // HeroXpSystem.XpCeiling
+using Xunit;
+
+namespace ProjectChimera.Sim.Tests.Definitions
+{
+    /// <summary>
+    /// Story 9.12 — the canonical <see cref="HeroProfileValidator"/> rule set (the single source of truth the init-time
+    /// apply gate, the client pre-flight, and the TS server RPC all obey). Covers every row of the spec I/O matrix:
+    /// valid, out-of-range level/xp, empty identity, illegal inventory, and illegal attributes. Godot-free (Tier-1).
+    /// </summary>
+    public class HeroProfileValidatorTests
+    {
+        private static readonly Fixed SampleXp = Fixed.FromRaw(786432); // 12.0 in 16.16
+
+        private static PlayerProfile Profile(
+            string profileId = "grommash#1", string heroDefId = "grommash",
+            IEnumerable<ProfileAttributeValue>? values = null,
+            IEnumerable<ProfileInventoryItem>? inventory = null)
+        {
+            var p = new PlayerProfile { ProfileId = profileId, HeroDefId = heroDefId };
+            p.Values = new List<ProfileAttributeValue>(values ?? new[]
+            {
+                new ProfileAttributeValue("hero.level", 3),
+                new ProfileAttributeValue("hero.xp", SampleXp.Raw),
+            });
+            if (inventory != null) p.Inventory = new List<ProfileInventoryItem>(inventory);
+            return p;
+        }
+
+        // ── Valid ────────────────────────────────────────────────────────────────────────
+
+        [Fact]
+        public void Valid_WellFormedProfile_IsValid()
+        {
+            ProfileValidation v = HeroProfileValidator.Validate(Profile());
+            Assert.True(v.IsValid);
+            Assert.Equal(ProfileInvalidReason.None, v.Reason);
+        }
+
+        [Fact]
+        public void Valid_XpExactlyAtCeiling_IsValid()   // ceiling is inclusive (legitimate saturation)
+        {
+            var p = Profile(values: new[]
+            {
+                new ProfileAttributeValue("hero.level", 1),
+                new ProfileAttributeValue("hero.xp", HeroXpSystem.XpCeiling.Raw),
+            });
+            Assert.True(HeroProfileValidator.Validate(p).IsValid);
+        }
+
+        [Fact]
+        public void Valid_LegacySlotlessInventory_MultipleMinusOne_IsValid()
+        {
+            var p = Profile(inventory: new[]
+            {
+                new ProfileInventoryItem("ring", 0, -1),   // legacy first-free sentinels — NOT a duplicate slot
+                new ProfileInventoryItem("potion", 2, -1),
+            });
+            Assert.True(HeroProfileValidator.Validate(p).IsValid);
+        }
+
+        // ── Range (level / xp) ─────────────────────────────────────────────────────────────
+
+        [Fact]
+        public void Range_NegativeLevel_IsRange()
+        {
+            var p = Profile(values: new[] { new ProfileAttributeValue("hero.level", -1) });
+            Assert.Equal(ProfileInvalidReason.Range, HeroProfileValidator.Validate(p).Reason);
+        }
+
+        [Fact]
+        public void Range_NegativeXp_IsRange()
+        {
+            var p = Profile(values: new[]
+            {
+                new ProfileAttributeValue("hero.level", 1),
+                new ProfileAttributeValue("hero.xp", -1),
+            });
+            Assert.Equal(ProfileInvalidReason.Range, HeroProfileValidator.Validate(p).Reason);
+        }
+
+        [Fact]
+        public void Range_XpAboveCeiling_IsRange()
+        {
+            var p = Profile(values: new[]
+            {
+                new ProfileAttributeValue("hero.level", 1),
+                new ProfileAttributeValue("hero.xp", HeroXpSystem.XpCeiling.Raw + 1),
+            });
+            Assert.Equal(ProfileInvalidReason.Range, HeroProfileValidator.Validate(p).Reason);
+        }
+
+        // ── Identity ────────────────────────────────────────────────────────────────────────
+
+        [Fact]
+        public void Identity_EmptyProfileId_IsIdentity()
+            => Assert.Equal(ProfileInvalidReason.Identity, HeroProfileValidator.Validate(Profile(profileId: "  ")).Reason);
+
+        [Fact]
+        public void Identity_EmptyHeroDefId_IsIdentity()
+            => Assert.Equal(ProfileInvalidReason.Identity, HeroProfileValidator.Validate(Profile(heroDefId: "")).Reason);
+
+        [Fact]
+        public void Identity_NullProfile_IsIdentity()
+            => Assert.Equal(ProfileInvalidReason.Identity, HeroProfileValidator.Validate(null).Reason);
+
+        // ── Inventory ──────────────────────────────────────────────────────────────────────
+
+        [Fact]
+        public void Inventory_NegativeCharges_IsInventory()
+        {
+            var p = Profile(inventory: new[] { new ProfileInventoryItem("ring", -1, 0) });
+            Assert.Equal(ProfileInvalidReason.Inventory, HeroProfileValidator.Validate(p).Reason);
+        }
+
+        [Fact]
+        public void Inventory_DuplicateSlot_IsInventory()
+        {
+            var p = Profile(inventory: new[]
+            {
+                new ProfileInventoryItem("ring", 0, 2),
+                new ProfileInventoryItem("potion", 0, 2),   // same non-negative slot → illegal
+            });
+            Assert.Equal(ProfileInvalidReason.Inventory, HeroProfileValidator.Validate(p).Reason);
+        }
+
+        // ── Attributes ─────────────────────────────────────────────────────────────────────
+
+        [Fact]
+        public void Attributes_NegativeRaw_IsAttributes()
+        {
+            var p = Profile(values: new[]
+            {
+                new ProfileAttributeValue("hero.level", 1),
+                new ProfileAttributeValue("hero.strength", -5),   // a non-level/xp attribute with a negative raw
+            });
+            Assert.Equal(ProfileInvalidReason.Attributes, HeroProfileValidator.Validate(p).Reason);
+        }
+
+        [Fact]
+        public void Attributes_DuplicateKey_IsAttributes()
+        {
+            var p = Profile(values: new[]
+            {
+                new ProfileAttributeValue("hero.level", 1),
+                new ProfileAttributeValue("hero.level", 2),   // duplicate key
+            });
+            Assert.Equal(ProfileInvalidReason.Attributes, HeroProfileValidator.Validate(p).Reason);
+        }
+
+        // ── Range is checked before Attributes (so a negative level reports `range`, not `attributes`) ──
+
+        [Fact]
+        public void RangeCheckedBeforeAttributes_NegativeLevel_ReportsRange()
+        {
+            // A negative level fails BOTH range (level < 0) and attributes (raw < 0); the I/O matrix requires `range`.
+            var p = Profile(values: new[] { new ProfileAttributeValue("hero.level", -3) });
+            Assert.Equal(ProfileInvalidReason.Range, HeroProfileValidator.Validate(p).Reason);
+        }
+
+        // ── The range predicate is the exact former LoadInto gate ──────────────────────────
+
+        [Fact]
+        public void IsLevelXpInRange_MatchesFormerInlinePredicate()
+        {
+            Assert.True(HeroProfileValidator.IsLevelXpInRange(0, 0));
+            Assert.True(HeroProfileValidator.IsLevelXpInRange(3, HeroXpSystem.XpCeiling.Raw)); // inclusive
+            Assert.False(HeroProfileValidator.IsLevelXpInRange(-1, 0));
+            Assert.False(HeroProfileValidator.IsLevelXpInRange(1, -1));
+            Assert.False(HeroProfileValidator.IsLevelXpInRange(1, HeroXpSystem.XpCeiling.Raw + 1));
+        }
+    }
+}

