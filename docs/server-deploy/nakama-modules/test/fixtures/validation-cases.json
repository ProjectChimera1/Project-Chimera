  "_ts_only_comment": "P1 boundary cases the TS validator must reject explicitly. These CANNOT round-trip through the C# PlayerProfile (System.Text.Json throws at deserialization: an out-of-Int32 `raw` overflows the `int` property; a non-array `values`/`inventory` is a type mismatch), so C# is fail-closed against them at the deserialization boundary rather than inside Validate. The C# test (TsOnlyBoundaryCases_CSharpRejectsAtTheDeserializationBoundary) asserts C# rejects each; the vitest suite asserts the TS validator returns the matching reason.",
  "ts_only_cases": [
    {
      "name": "xp_raw_above_int32_max_wraps_under_naive_truncation",
      "expect_valid": false,
      "expect_reason": "range",
      "profile": {
        "profile_id": "grommash#1",
        "hero_def_id": "grommash",
        "values": [ { "key": "hero.level", "raw": 1 }, { "key": "hero.xp", "raw": 4294967296 } ],
        "inventory": []
      }
    },
    {
      "name": "attribute_raw_above_int32_max",
      "expect_valid": false,
      "expect_reason": "attributes",
      "profile": {
        "profile_id": "grommash#1",
        "hero_def_id": "grommash",
        "values": [ { "key": "hero.level", "raw": 1 }, { "key": "hero.strength", "raw": 4294967296 } ],
        "inventory": []
      }
    },
    {
      "name": "values_present_but_not_an_array",
      "expect_valid": false,
      "expect_reason": "attributes",
      "profile": {
        "profile_id": "grommash#1",
        "hero_def_id": "grommash",
        "values": "not-an-array",
        "inventory": []
      }
    },
    {
      "name": "inventory_present_but_not_an_array",
      "expect_valid": false,
      "expect_reason": "inventory",
      "profile": {
        "profile_id": "grommash#1",
        "hero_def_id": "grommash",
        "values": [ { "key": "hero.level", "raw": 1 } ],
        "inventory": { "item_id": "ring", "charges": 0, "slot": 0 }
      }
    }
  ]
