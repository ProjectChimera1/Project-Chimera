{
  "mcpServers": {
    "godot-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@satelliteoflove/godot-mcp"],
      "env": {}
    },
    "blender-mcp": {
      "type": "stdio",
      "command": "D:/tools/blender-mcp/venv/Scripts/python.exe",
      "args": ["-m", "blmcp", "--transport", "stdio"],
      "env": {
        "PYTHONPATH": "D:/tools/blender-mcp/bundle"
      }
    }
  }
}
