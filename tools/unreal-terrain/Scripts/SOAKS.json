   "frames": 150,
   "phase": "idle"
  },
  {
   "op": "wait_collision",
   "name": "init"
  },
  {
   "op": "soak",
   "minutes": 5,
   "seed": 11,
   "cycle_s": 5,
   "diameters": [
    5,
    20,
    60,
    100
   ],
   "s": 10,
   "phase": "soak"
  },
  {
   "op": "wait_collision",
   "name": "end"
  },
  {
   "op": "verify_collision",
   "name": "end"
  },
  {
