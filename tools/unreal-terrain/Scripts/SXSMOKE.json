{
  "name": "SXSMOKE",
  "about": "Scatter S4 smoke (plan-c-scatter.md 3.8, 4 S4): run with -ChimeraTerrainScatter=1. Fill, verify, hide/show by cull distance (the hidden shot must not hang), a raise and a dirt paint followed live, a disable while tiles are Busy and a re-enable, then one undo per stroke: reference and live return to the first hash.",
  "ops": [
    {"op": "look", "mode": "compare"},
    {"op": "camera", "pose": "rts80"},
    {"op": "scatter_wait", "timeout_s": 600, "phase": "fill"},
    {"op": "settle", "frames": 150, "phase": "idle"},
    {"op": "hash", "name": "start"},
    {"op": "scatter_verify", "name": "start"},
    {"op": "shot", "name": "shown"},
    {"op": "scatter_visible", "value": 0},
    {"op": "settle", "frames": 150},
    {"op": "shot", "name": "hidden"},
    {"op": "scatter_visible", "value": 1},
    {"op": "settle", "frames": 150},
    {"op": "stroke", "mode": "raise", "d": 30, "s": 60, "path": [[20, 20], [35, 30]], "ticks": 30, "phase": "edit"},
    {"op": "paint", "layer": 1, "d": 8, "s": 100, "path": [[-40, -10], [10, 15]], "ticks": 30},
    {"op": "scatter_wait"},
    {"op": "scatter_verify", "name": "edited"},
    {"op": "hash", "name": "edited"},
    {"op": "paint", "layer": 1, "d": 20, "s": 100, "path": [[-60, 30], [-20, 40]], "ticks": 20},
    {"op": "scatter", "value": 0, "phase": "toggle"},
    {"op": "scatter", "value": 1},
    {"op": "scatter_wait", "timeout_s": 300},
    {"op": "scatter_verify", "name": "reenabled"},
    {"op": "undo", "n": 3, "phase": "undo"},
    {"op": "scatter_wait"},
    {"op": "scatter_verify", "name": "undone"},
    {"op": "hash", "name": "final"},
    {"op": "settle", "frames": 150, "phase": "idle_end"},
    {"op": "shot", "name": "final"}
  ]
}
