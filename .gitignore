# Godot build cache
godot/.godot/

# .NET build output
godot/.mono/
godot/bin/
godot/obj/
# Story 1.10a: also cover the nested Godot-free test project (godot/ProjectChimera.Sim.Tests/bin|obj)
# and any other nested build output, so build artifacts can never be committed by accident.
**/bin/
**/obj/

# VS/Rider IDE files
.vs/
*.user
*.suo
.idea/

# Story 8.1: API-key secret store — never commit keys or the secrets dir
*.key
secrets/

# LAN determinism-gate run logs (godot/tools/lan-desync-smoke.ps1 writes here). Machine-specific
# run artifacts — the FINDINGS belong in the ledger / Snapshot, never the raw logs.
lan-logs/

# OS junk
.DS_Store
Thumbs.db

# Local Claude Code permissions (machine-specific)
.claude/settings.local.json
.bmad-loop/runs/
.bmad-loop/archive/
.bmad-loop/cache/
.bmad-loop/policy.toml
.bmad-loop/scratch_*
